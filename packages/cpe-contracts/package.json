{
  "name": "@yolafresh/cpe-contracts",
  "version": "1.0.0-cpe.1",
  "description": "Contratos fiscales CPE aislados de los contratos operativos de YolaFresh",
  "private": true,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/contracts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/cpe-contract.test.js",
    "prepack": "npm test"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "typescript": "^5.0.0"
  }
}
